        "--bg": "#ffffff",
        "--surface": "#ffffff",
        "--surface-2": "#f6f6f7",
        "--surface-3": "#ededef",
        "--border": "rgba(0, 0, 0, 0.10)",
        "--border-strong": "rgba(0, 0, 0, 0.22)",
        "--fg": "#111111",
        "--muted": "#6b7280",
        "--accent": "#ea580c",
        "--accent-hover": "#c2410c",
        "--accent-text": "#c2410c",
        "--accent-soft": "rgba(234, 88, 12, 0.12)",
        "--accent-ring": "rgba(234, 88, 12, 0.35)",
        "--on-accent": "#ffffff",
        "--on-accent-soft": "rgba(255, 255, 255, 0.18)",
        "--shadow": "0 8px 24px rgba(0, 0, 0, 0.08)",
        "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.06)"
      }
    },
    "dark": {
      "selector": ":root.theme-dark",
      "media": null,
      "tokens": {
        "--bg": "#000000",
        "--surface": "#101012",
        "--surface-2": "#17171a",
        "--surface-3": "#1f1f24",
        "--border": "rgba(255, 255, 255, 0.10)",
        "--border-strong": "rgba(255, 255, 255, 0.20)",
        "--fg": "#f4f4f5",
        "--muted": "#a1a1aa",
        "--accent": "#7c3aed",
        "--accent-hover": "#6d28d9",
        "--accent-text": "#a78bfa",
        "--accent-soft": "rgba(124, 58, 237, 0.18)",
        "--accent-ring": "rgba(124, 58, 237, 0.45)",
        "--on-accent": "#ffffff",
        "--on-accent-soft": "rgba(255, 255, 255, 0.18)",
        "--shadow": "0 8px 24px rgba(0, 0, 0, 0.55)",
        "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.45)"
      }
    },
    "light": {
      "selector": ":root.theme-light",
      "media": null,
      "tokens": {
        "--bg": "#ffffff",
        "--surface": "#ffffff",
        "--surface-2": "#f6f6f7",
        "--surface-3": "#ededef",
        "--border": "rgba(0, 0, 0, 0.10)",
        "--border-strong": "rgba(0, 0, 0, 0.22)",
        "--fg": "#111111",
        "--muted": "#6b7280",
        "--accent": "#ea580c",
        "--accent-hover": "#c2410c",
        "--accent-text": "#c2410c",
        "--accent-soft": "rgba(234, 88, 12, 0.12)",
        "--accent-ring": "rgba(234, 88, 12, 0.35)",
        "--on-accent": "#ffffff",
        "--on-accent-soft": "rgba(255, 255, 255, 0.18)",
        "--shadow": "0 8px 24px rgba(0, 0, 0, 0.08)",
        "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.06)"
      }
    }
  }
}
