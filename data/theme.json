{
  "$comment": "Colour palettes. Edit here and run `npm run generate:tokens` to rebuild app/styles/tokens.generated.css. Dark is black with purple, light is white with orange. Every colour in the stylesheets comes from these tokens; nothing is hard-coded elsewhere.",
  "$tokens": {
    "--bg": "Page background",
    "--surface": "Cards and panels",
    "--surface-2": "Inputs and inset areas, one step off the surface",
    "--surface-3": "Hover state for neutral controls",
    "--border": "Hairline borders",
    "--border-strong": "Borders on hover, open or focused elements",
    "--fg": "Body text",
    "--muted": "Secondary text",
    "--accent": "Brand colour for filled controls",
    "--accent-hover": "Filled controls on hover",
    "--accent-text": "Brand colour used as text or an icon on the page background",
    "--accent-soft": "Brand colour as a light tint behind text",
    "--accent-ring": "Focus ring",
    "--on-accent": "Text on a filled control",
    "--shadow": "Card shadow",
    "--shadow-sm": "Control shadow",
    "--on-accent-soft": "A translucent tint of --on-accent, for a shape drawn on top of a filled control"
  },
  "palettes": {
    "base": {
      "selector": ":root",
      "media": null,
      "tokens": {
        "--bg": "#000000",
        "--surface": "#101012",
        "--surface-2": "#17171a",
        "--surface-3": "#1f1f24",
        "--border": "rgba(255, 255, 255, 0.10)",
        "--border-strong": "rgba(255, 255, 255, 0.20)",
        "--fg": "#f4f4f5",
        "--muted": "#a1a1aa",
        "--accent": "#7c3aed",
        "--accent-hover": "#6d28d9",
        "--accent-text": "#a78bfa",
        "--accent-soft": "rgba(124, 58, 237, 0.18)",
        "--accent-ring": "rgba(124, 58, 237, 0.45)",
        "--on-accent": "#ffffff",
        "--on-accent-soft": "rgba(255, 255, 255, 0.18)",
        "--shadow": "0 8px 24px rgba(0, 0, 0, 0.55)",
        "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.45)",
        "--radius-lg": "18px",
        "--radius-md": "12px",
        "--radius-sm": "10px",
        "--font-system": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
        "--font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      }
    },
    "systemLight": {
      "selector": ":root",
      "media": "(prefers-color-scheme: light)",
