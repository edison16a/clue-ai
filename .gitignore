# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest
/test-results

# next.js
/.next/
/out/

# production
/build
/dist

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS cruft — these get created by Finder/Explorer just by browsing the repo,
# so they are committed by accident unless they are ignored up front.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Per-user editor and IDE state. These record one developer's open tabs,
# breakpoints and local run configs; they are machine-specific and cause
# pointless merge conflicts when shared.
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~
.history/

# Stray backup/patch files left behind by editors and merge tools
*.bak
*.orig
*.rej
